// ============================================================
// Azure Log Analytics — WindowsEvent Sample Query
// Purpose: Extract one representative event per EventID
//          INCLUDING all EventData sub-fields specific to
//          that EventID — for Cribl Stream parsing reference
// Table:   WindowsEvent
// ============================================================
// Instructions:
//   1. Open Azure Portal > Log Analytics workspace > Logs
//   2. Paste this query and run it (adjust lookback if needed)
//   3. Export results: "Export" > "CSV (all columns)"
//   4. Save as: azure_windowsevent_samples.csv
// ============================================================

let lookback = 2d;

// ── Step 1: One latest sample per EventID ──────────────────
let Samples = WindowsEvent
| where TimeGenerated > ago(lookback)
| summarize arg_max(TimeGenerated, *) by EventID;

// ── Step 2: Expand EventData into individual named columns ──
// bag_keys() lists every sub-field name present in EventData
// for that specific EventID — this is the event-specific schema.
// mv-expand then pivots each key into its own row so you can
// see fiel